     if (typeof url !== 'string' || !url.startsWith('https://')) fail(`${door}: prices.json has no ${key} link`);
     links[key] = url;
   }
   return { month: json.month, pool: json.pool, tiers: json.tiers.map(({ tier, usd, label }) => ({ tier, usd, label })), links };
