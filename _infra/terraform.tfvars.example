# GCP configuration
gcp_project_id = "csarko-sh"
gcp_region     = "us-west1"

# Public hostname. The Route53 zone must already exist.
domain_name   = "csarko.sh"
dns_zone_name = "csarko.sh"

# The admin dashboard and its API (docs/superpowers/specs/2026-10-12-admin-
# dashboard-design.md). The defaults are right for this site; listed so they
# are easy to find.
# admin_domain_name     = "admin.csarko.sh"
# admin_hosting_site_id = "csarko-sh-admin"
# youtube_handle        = "csarkosh"
# github_owner          = "csarkosh"

# Required: the cutover instant, the next whole UTC hour after the site deploy
# that switched to lib-visits (variables.tf says why it has no default).
# visits_history_until = "2026-10-15T18:00:00Z"

# Optional: a monthly budget alert for the whole project. Empty creates none.
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# monthly_budget_usd = 5

# The Google accounts that may read admin.csarko.sh.
admin_emails = ["you@example.com"]
