# GCP configuration
gcp_project_id = "csarko-sh"
gcp_region     = "us-west1"

# Public hostname. The Route53 zone must already exist.
domain_name   = "csarko.sh"
dns_zone_name = "csarko.sh"

# The admin dashboard and its API (docs/superpowers/specs/2026-10-12-admin-
# dashboard-design.md). The defaults are right for this site; listed so they
# are easy to find.
# admin_domain_name     = "admin.csarko.sh"
# admin_hosting_site_id = "csarko-sh-admin"
# youtube_handle        = "csarkosh"
# github_owner          = "csarkosh"

# Your own addresses, so the dashboard never counts you (plain or CIDR, v4 and v6).
# visits_ignore_ips = ["203.0.113.9", "2001:db8:1234:5678::/64"]

# Required: the cutover instant, the next whole UTC hour after the site deploy
# that switched to lib-visits (variables.tf says why it has no default).
# visits_history_until = "2026-10-15T18:00:00Z"

# The billing account: a monthly budget alert for the whole project, and the name
# of the Cloud Billing export table the admin dashboard's Finance page reads
# (gcp_billing_export_v1_<id with underscores>). Empty creates no budget and
# leaves the Finance page's GCP side unconfigured.
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# monthly_budget_usd = 5

# The Google accounts that may read admin.csarko.sh.
admin_emails = ["you@example.com"]

# Mail (docs/superpowers/specs/2026-10-30-email-aliases-design.md). Where every alias forwards.
mail_owner_address = "you@example.com"
# The cutover, in order: the trial runs on test.<domain> with the apex untouched; then
# mail_manage_apex_mx = true points the apex at SES; mail_cutover_complete = true once the old
# mail provider can no longer send as the domain (SPF and DMARC tighten); then
# mail_trial_subdomain = "" removes the trial MX.
# mail_trial_subdomain  = "test"
# mail_manage_apex_mx   = false
# mail_cutover_complete = false
# mail_protected_aliases = ["tips"]
