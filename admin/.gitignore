# The Day Hike admin bundle is built in game-dayhike and pulled in by admin/deploy.sh
# from gs://fps-csarko-downloads/admin/latest/ right before `firebase deploy`.
public/game-dayhike/

# The build tooling for the vendored Firebase Auth SDK (`npm install` here); the bundle it
# writes, public/vendor/firebase-auth.<hash>.js, is committed like every generated asset.
node_modules/
