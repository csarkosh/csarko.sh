# Copy to .env.local (git-ignored) for `npm run dev`. Every value is optional
# a missing or `unset` credential makes its section read null.
ADMIN_EMAILS=you@example.com
FIREBASE_PROJECT=csarko-sh
ADMIN_STORE=memory
VISITS_DATASET=csarko_visits
VISITS_HISTORY_DATASET=csarko_history
VISITS_HISTORY_UNTIL=2026-10-16T00:00:00Z
# GSC_SA_KEY is the key file's content on one line, for example:
# GSC_SA_KEY=$(cat ~/.config/csarko-sh/gsc-sa.json)   (shell only; in this file paste the JSON itself)
YOUTUBE_KEY=unset
GITHUB_TOKEN=unset
PSI_KEY=unset
